{
  "name": "smart-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A modern full-stack productivity platform for teams",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "predev": "npx kill-port 3000 3001 3002 3003 5000 5001",
    "dev": "npm run predev && concurrently --raw --names \"client,server\" -k \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cross-env PORT=3000 vite --host 0.0.0.0 --port 3000",
    "dev:server": "cross-env PORT=5001 node server/server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "chart.js": "^3.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "framer-motion": "^11.11.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.54.0",
    "mongodb-memory-server": "^8.11.0",
    "mongoose": "^8.24.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^4.0.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
